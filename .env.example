APP_PORT=8080
API_PORT=8081
SQLITE_PATH=/data/sqoch.db
LOG_LEVEL=info
DEMO_MODE=true

# Local demo only: replace password and secret for your environment.
ADMIN_HOST=admin.localhost
ADMIN_ORIGIN=http://admin.localhost:${APP_PORT}
ADMIN_EMAIL=organizer@sqoch.local
ADMIN_PASSWORD=local-organizer-change-me
JWT_SECRET=local-only-change-this-secret-32-bytes-minimum
JWT_TTL=1h

# RabbitMQ is available only inside the Compose network.
RABBITMQ_USER=sqoch
RABBITMQ_PASSWORD=local-rabbit-change-me
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672/
RABBITMQ_COMMAND_QUEUE=sqoch.notifications.commands.v1
RABBITMQ_RESULT_QUEUE=sqoch.notifications.results.v1
NOTIFICATION_SERVICE_TOKEN=local-only-notifier-token-change-me-32-bytes
OUTBOX_INTERVAL=250ms

# Separate service and mock-provider databases, both in notifier_data.
NOTIFIER_PORT=8082
NOTIFIER_SQLITE_PATH=/data/notifier.db
MOCK_SQLITE_PATH=/data/mock-provider.db
BACKEND_INTERNAL_URL=http://backend:${API_PORT}
NOTIFIER_INTERVAL=250ms
NOTIFIER_LEASE=30s
NOTIFIER_TIMEOUT=5s
NOTIFIER_RETRY_BASE=2s
NOTIFIER_MAX_ATTEMPTS=3
MOCK_SEND_DELAY=1s
# none | temporary_once | after_accept_once | always_fail
MOCK_FAILURE_MODE=none

# Assistant: choose a model with tool calling in OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AGENT_TIMEOUT=120s
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=4096
